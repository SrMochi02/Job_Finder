# Credenciales SMTP de Gmail (Usar Contraseña de Aplicación de 16 caracteres, NO tu contraseña normal)
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
REMITENTE_NOMBRE=Tu Nombre Completo
REMITENTE_TELEFONO=+503 0000-0000

# Ruta local hacia tu CV en formato PDF
CV_PATH=./cv_postulante.pdf

# Base de datos SQLite
DB_PATH=./jobfinder.db

# Configuración de búsqueda
UBICACION_OBJETIVO=San Miguel
PAGINAS_MAXIMAS=3
HEADLESS_SCRAPER=False

# Sectores o palabras clave a excluir (separadas por coma)
PALABRAS_EXCLUIDAS=cocina,cocinero,cocinera,chef,mesero,mesera,lavaplatos,restaurante,pupuseria,panadero,pastelero,barista,parrillero,comida rapida,gastronomia,bartender,steward

# Límites diarios de seguridad (Rate Limiting)
MAX_EMAILS_POR_DIA=12
MAX_WHATSAPP_POR_DIA=6
DELAY_MIN_SEGUNDOS=30
DELAY_MAX_SEGUNDOS=90

# Directorio para sesión persistente de WhatsApp Web
WHATSAPP_SESSION_DIR=./whatsapp_session
