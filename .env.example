# Credenciales SMTP de Gmail (Usar Contraseña de Aplicación de 16 caracteres, NO tu contraseña normal)
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
REMITENTE_NOMBRE=Tu Nombre Completo
REMITENTE_TELEFONO=+503 0000-0000
DIRECCION_RESIDENCIA=San Miguel, El Salvador
PRETENSION_SALARIAL=450
ULTIMO_SALARIO=380
EDAD_POSTULANTE=21 años
ESTADO_CIVIL_POSTULANTE=Acompañado
MOTIVO_SALIDA_ULTIMO_EMPLEO=Búsqueda de superación profesional y estabilidad laboral a largo plazo.

# Horario activo de operación automática (Formato 24h: 7 = 7:00 AM, 16 = 4:00 PM)
HORA_INICIO_JORNADA=7
HORA_FIN_JORNADA=16
INTERVALO_CICLO_MINUTOS=45

# Ruta local hacia tu CV en formato PDF
